{
  "name": "nukkad",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@nukkad/api",
    "dev:web": "turbo dev --filter=@nukkad/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "db:generate": "npm run generate --workspace=@nukkad/db",
    "db:push": "npm run push --workspace=@nukkad/db",
    "db:seed": "npm run seed --workspace=@nukkad/db",
    "db:seed:kb": "npm run seed:kb --workspace=@nukkad/db",
    "db:studio": "npm run studio --workspace=@nukkad/db",
    "eval": "npm run eval --workspace=@nukkad/eval",
    "eval:bill": "npm run eval:bill --workspace=@nukkad/eval",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.2",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.0.0",
  "dependencies": {
    "dotenv": "^17.4.1"
  }
}
