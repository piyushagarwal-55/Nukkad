# =============================================================
#  Nukkad  .env.example    copy to .env and fill in
# =============================================================

# --- Twilio, WhatsApp transport ------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender is SHARED and fixed, not your own Twilio number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_JOIN_CODE=
TWILIO_SMS_NUMBER=

# --- Public tunnel -------------------------------------------
PUBLIC_BASE_URL=

# --- ASR, Hinglish -------------------------------------------
# Shunya Labs zero-indic. Preferred when set: returns ROMAN directly on
# language_code=en, which the resolver can read without a transliteration
# hop. Leave blank to use Groq Whisper.
SHUNYA_API_KEY=
SHUNYA_LANGUAGE=en
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=saaras:v3
# transcribe | translate | verbatim | transliterate | codemix
SARVAM_MODE=codemix

# --- LLM -----------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Razorpay ------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Database ------------------------------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Demo personas -------------------------------------------
DEMO_HOUSEHOLD_NUMBER=
DEMO_KIRANA_NUMBER=

# --- App -----------------------------------------------------
PORT=3000
NODE_ENV=development
